# Environment variables for the arcade_matter MCP server.
#
# Copy to .env, make it readable only by you, and fill in your token:
#   cp .env.example .env && chmod 600 .env
#
# `arcade deploy` uploads the secrets the tools declare from .env. To rotate the token
# later without redeploying, run `arcade secret set MATTER_API_TOKEN=mat_...`.
#
# Never commit .env or copy the token into issues, tasks, logs or chat.

# Matter personal API token (needs Matter Pro). Generate one at
# https://web.getmatter.com/settings. Generating a new token revokes the old one.
MATTER_API_TOKEN=mat_your_token_here
